</script><script>window.LESSON_WORDS={"艰巨": {"meaning": "困难很多，任务繁重。"}, "昂贵": {"meaning": "价格或成本很高。"}, "消耗": {"meaning": "在使用过程中逐渐耗去。"}, "干旱": {"meaning": "长时间降雨不足而缺水。"}, "趋势": {"meaning": "整体发展的方向。"}, "因素": {"meaning": "影响结果的原因或条件。"}, "水喉": {"meaning": "本地日常用语，指水龙头。文中“四大水喉”比喻供水来源。"}, "新生水": {"meaning": "经处理净化、供再使用的再生水。"}, "淡化水": {"meaning": "把海水中的盐分去除后得到的水。"}, "能源": {"meaning": "能提供能量的资源。"}, "运输": {"meaning": "把人或物从一个地方送到另一个地方。"}, "扩大": {"meaning": "使范围或规模变大。"}, "集水区": {"meaning": "收集雨水并让雨水流入蓄水池的地区。"}, "蓄水池": {"meaning": "用来储存水的地方。"}, "有限": {"meaning": "有一定限制，并不是无穷无尽。"}, "需求": {"meaning": "需要的数量或内容。"}, "比例": {"meaning": "一部分与整体或另一部分的数量关系。"}, "平均": {"meaning": "把总量按人数等均分所得的数。"}, "浴室": {"meaning": "供人洗澡的房间。"}, "目标": {"meaning": "希望达到的结果。"}, "来之不易": {"meaning": "得到它并不容易，需要付出努力或资源。"}, "开源节流": {"meaning": "增加来源，同时减少不必要的消耗。文中指拓展水源并节约用水。"}, "可持续发展": {"meaning": "发展时也顾及未来的需要，避免耗尽资源。"}};
