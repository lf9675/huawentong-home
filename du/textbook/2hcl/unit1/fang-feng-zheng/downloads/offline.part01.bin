<!doctype html><html lang="zh-SG"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="中二高级华文 单元一 放风筝 课文教学配套"><title>放风筝 · 互动学习 · 华文通</title><style>@font-face{font-family:LessonKai;src:url(data:font/woff2;base64,);font-display:swap}@font-face{font-family:LessonSong;src:url(data:font/woff2;base64,);font-display:swap}
:root{--ink:#243d37;--green:#245e51;--red:#b03e37;--muted:#62736d;--line:#d5e0d8;--paper:#fffcf6;font-family:LessonSong,serif;color:var(--ink);background:#f4f7f3;font-size:17px}*{box-sizing:border-box}body{margin:0}a{color:var(--green);text-underline-offset:4px}button,input,select,textarea{font:inherit;color:inherit}button,select,.btn,summary{min-height:46px;touch-action:manipulation}button,.btn,select{border:1px solid #a8bbb0;border-radius:8px;background:white;padding:10px 14px;cursor:pointer;text-decoration:none}button:hover,.btn:hover{background:#edf4ed}button:disabled{opacity:.5;cursor:default}button.active,.primary{background:var(--green);color:white;border-color:var(--green)}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible,select:focus-visible{outline:3px solid #d69a32;outline-offset:3px}.kai,.kaiti,textarea,.question,.model,.sentence,.option{font-family:LessonKai,KaiTi,serif}.key{color:var(--red);font-weight:700}h1,h2,h3,p{margin-top:0}h1{font:52px LessonKai,serif;margin-bottom:12px}h2{font-size:28px}h3{font-size:21px;margin:24px 0 12px}p{line-height:1.8}.muted,small{color:var(--muted)}small{font-size:15px;line-height:1.5}.site-header{background:white;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px;padding:10px 24px}.site-header img{width:230px;max-width:45vw;height:auto;display:block}.site-header span{font-size:15px}main{max-width:1240px;margin:auto;padding:24px 24px 60px}.nav,.actions,.toolbar,.word-add-row,.notebook-nav,.action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0}.nav{margin:0;padding:12px 24px;background:#f4f7f3;border-bottom:1px solid var(--line)}.nav button{font-size:16px}.crumb{margin-bottom:22px;color:var(--muted);font-size:15px}.workspace{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:28px;align-items:start}.paper{background:var(--paper);padding:26px;border:1px solid var(--line);border-radius:12px}.source-text{font:25px/2 LessonKai,serif;white-space:normal;overflow-wrap:anywhere}.source-paragraph{margin-bottom:26px}.source-paragraph h3{font:19px LessonSong,serif;color:var(--green);margin-top:0}.sentence{border-radius:4px;cursor:pointer}.sentence.selected{background:#ffecb3;box-shadow:0 0 0 2px #c58d25}.word{color:var(--green);text-decoration:underline dotted;text-underline-offset:6px;cursor:pointer}.para-name{font:30px LessonKai,serif}.panel{position:relative;overflow:hidden;background:#f7e8d7;width:100%;margin-bottom:16px}.panel img{position:absolute;max-width:none;height:auto;display:block}.panel-list{max-width:600px}.paragraph-idea{margin-top:20px}.paragraph-idea summary{color:var(--green)}.question{font-size:25px;line-height:1.7}.guide{font-size:16px;line-height:1.65;color:var(--green)}.eyebrow{font-size:15px;color:var(--red);margin-bottom:12px}.evidence{width:100%;text-align:left;min-height:66px;border:2px dashed #a8b9ab;margin:8px 0;font:20px/1.6 LessonKai,serif;background:white}.evidence.filled{border-style:solid;background:#eef4ec}.evidence-label{font-size:16px}.evidence-row{margin-bottom:15px}.remove-evidence{font-size:14px;padding:3px 10px;min-height:36px}.option{display:flex;align-items:flex-start;gap:10px;background:white;border:1px solid var(--line);border-radius:8px;padding:14px;margin:10px 0;font-size:22px;line-height:1.5;cursor:pointer}.option input{margin-top:8px;min-width:20px;min-height:20px}.option.chosen{border-color:var(--green);background:#edf5ee}fieldset{border:0;padding:0;margin:20px 0}legend{font:22px/1.6 LessonKai,serif}input[type=text],input:not([type]),textarea{background:white;border:1px solid #adbbb1;border-radius:7px;padding:12px;max-width:100%}textarea{display:block;width:100%;font-size:22px;line-height:1.7;resize:vertical;min-height:100px}.answer-label{display:block;margin:20px 0 8px;font-size:17px}.word-add-row input{flex:1;min-width:140px;width:0}.notice{background:#fff0cf;border-left:4px solid #bf871d;padding:14px;line-height:1.7}.success{background:#e9f4e8;border-left:4px solid #39724f;padding:14px;line-height:1.7}.solution{margin-top:24px;padding-top:20px;border-top:2px solid #a6bcab}.model{font-size:22px;line-height:1.8}.selfcheck label{display:block;padding:9px 0;line-height:1.6}.selfcheck input{width:20px;height:20px;margin-right:8px}.concept{margin:20px 0;padding:18px 0;border-block:1px solid var(--line)}.concept p{margin-bottom:12px}.concept strong{color:var(--red)}.idiom-list{display:grid;grid-template-columns:auto 1fr;gap:10px 18px}.idiom-list dt{font:23px LessonKai,serif;color:var(--red)}.idiom-list dd{margin:0;font-size:17px;line-height:1.65}.blank-row{font:23px/2 LessonKai,serif;margin:18px 0}.blank-row select{font:20px LessonKai,serif;max-width:100%;margin:4px}.task-footer{border-top:1px solid var(--line);margin-top:24px;padding-top:16px;display:flex;justify-content:space-between;gap:10px}details{margin:18px 0}summary{cursor:pointer;line-height:1.6}.question-source{font-size:14px;margin-top:10px}.record-row{display:grid;grid-template-columns:1fr auto auto;gap:18px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}.record{padding:22px 0;border-bottom:1px solid var(--line)}.record p{white-space:pre-wrap}.identity{display:flex;gap:10px;flex-wrap:wrap}.identity label{font-size:15px;flex:1;min-width:140px}.identity input{display:block;width:100%;margin-top:6px}dialog{width:min(850px,94vw);max-height:90vh;border:1px solid #a5b6a9;border-radius:12px;padding:28px;color:var(--ink);background:var(--paper)}dialog::backdrop{background:#10231d99}.dialog-close{float:right;margin-left:14px}.notebook-list{display:grid;gap:16px}.notebook-word{border-top:1px solid var(--line);padding:16px 0}.notebook-word h3{margin:0 0 8px;font-size:28px}.notebook-word p{margin-bottom:8px}.notebook-word blockquote{font:21px/1.7 LessonKai,serif;margin:14px 0}.notebook-word blockquote small{display:block;font:14px LessonSong,serif}.file-button{position:relative;overflow:hidden;padding:12px;border:1px solid #a8bbb0;border-radius:8px;cursor:pointer}.file-button input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}.flashcard{text-align:center;padding:30px 12px;min-height:250px}.flash-word{font:48px LessonKai,serif}.flash-back{text-align:left}.flash-back blockquote{font:22px/1.7 LessonKai,serif}.flash-back small{display:block}.status-tag{font-size:14px;color:var(--green)}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:34px;align-items:center;padding:30px 0 40px}.lead{font:28px/1.6 LessonKai,serif}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:white;border:1px solid var(--line);border-radius:10px;padding:24px}.card p{font-size:17px}.teacher-link{margin-top:30px;padding-top:24px;border-top:1px solid var(--line)}table{border-collapse:collapse;width:100%;margin:20px 0}td,th{padding:12px;text-align:left;vertical-align:top;border:1px solid var(--line);line-height:1.6}th{background:#e9efe8}.comic-full{display:block;max-width:850px;width:100%;height:auto;margin:30px auto}.text-full{font:24px/1.9 LessonKai,serif;max-width:850px;margin:auto}.projector{background:#182e27;border-radius:10px;padding:14px}.projector img{width:100%;display:block;object-fit:contain}.projector:fullscreen{display:flex;justify-content:center;flex-direction:column}.projector:fullscreen img{max-height:calc(100vh - 100px)}.slide-label{color:white;margin-left:auto}.slide-notes{margin-top:20px;padding:20px;background:white;border:1px solid var(--line)}.slide-notes p{white-space:pre-wrap}.oral-block{margin-top:20px;padding:12px 0}.footer-note{border-top:1px solid var(--line);padding-top:20px;margin-top:30px;color:var(--muted);font-size:15px}[hidden]{display:none!important}@media(max-width:760px){main{padding:20px 16px 40px}.workspace,.hero,.cards{grid-template-columns:1fr}.paper{padding:20px}.site-header{padding:10px 16px}.site-header span{font-size:12px}.nav{padding:10px 16px}.nav button{font-size:14px;padding:9px}h1{font-size:43px}.source-text{font-size:24px}.question{font-size:24px}.record-row{grid-template-columns:1fr auto}.record-row button{grid-column:2}.cards{gap:14px}.hero{padding-top:12px}.idiom-list{grid-template-columns:1fr}.idiom-list dd{margin-bottom:12px}}@media print{.site-header,.nav,.toolbar,.actions,.task-footer,button,.teacher-link{display:none}.workspace{display:block}.paper{border:0}main{max-width:none;padding:0}}

.evidence-input{display:block;width:100%;min-height:8em;resize:vertical;font:1.2rem/1.9 LessonKai,serif;padding:.7rem;border:1px solid #a2b5aa;border-radius:8px;background:#fffdf7}.reference-nav{display:block;margin:.5rem 0} .reference-nav select{max-width:100%}
</style><style>.concept b{color:var(--red)}</style></head><body><header class="site-header"><a href="https://huawentong-home.lyqlym2015.workers.dev/"><img src="data:image/png;base64," alt="华文通"></a><span>中二高级华文 · 单元一</span></header><nav class="nav"><a class="btn" href="https://huawentong-home.lyqlym2015.workers.dev/du/textbook/2hcl/unit1/fang-feng-zheng/index.html">主页</a><button data-view="read">读文</button><button data-view="lesson1">第一课</button><button data-view="lesson2">第二课</button><button data-view="lesson3">第三课</button><button data-view="review">检查</button><button id="wordList">词语本</button></nav><main><p class="muted">离线版 · 关闭前请导出学习记录。</p><p id="saveState" class="muted" role="status"></p><div id="readTask" class="workspace"><article id="source" class="paper"></article><section id="activity" class="paper"></section></div><section id="review" class="paper" hidden></section><dialog id="dialog"><button id="dialogClose" class="dialog-close">关闭</button><div id="dialogContent"></div></dialog><dialog id="wordDialog"><button id="wordDialogClose" class="dialog-close">关闭</button><div id="wordDialogContent"></div></dialog></main><script>window.LESSON_ASSETS={"comic1": "data:image/png;base64,