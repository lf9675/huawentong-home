 function persist(){try{localStorage.setItem(KEY,JSON.stringify(book));return true}catch{return false}}
 function examples(word){const ctx=context();if(ctx.examplesMap?.[word]?.text)return [{lessonId:lesson.id,lessonTitle:lesson.title+' · '+ctx.examplesMap[word].label,p:null,text:ctx.examplesMap[word].text}];if(ctx.selectedSource?.includes(word))return [{lessonId:lesson.id,lessonTitle:lesson.title,p:null,text:ctx.selectedSource}];const found=[];(context().paragraphs||[]).forEach((p,i)=>{const token=p.includes(word)?word:Object.keys(window.WORD_ALIASES||{}).find(k=>window.WORD_ALIASES[k]===word&&p.includes(k));if(token){const sentence=(p.match(/[^。！？]+[。！？]?/g)||[p]).find(s=>s.includes(token));found.push({lessonId:lesson.id,lessonTitle:lesson.title,p:i+1,text:sentence||p})}});return found.slice(0,3)}
 function add(raw){reload();refreshContext();if(!lesson.id&&lessonFilter){const c=resolve(lessonFilter);lesson={...c,id:c.id}}if(!lesson.id)return {ok:false,message:'请选择课文，再加入词语。'};const word=normal(raw);if(!valid(word))return {ok:false,message:'每次输入一个词语（1—20个汉字）；也可选中原文中的词语后加入。'};let e=book.entries.find(e=>e.word===word),duplicate=!!e;const now=new Date().toISOString();if(e){e.lessons=[...new Set([...(e.lessons||[]),lesson.id])];const ex=examples(word);e.examples=[...(e.examples||[]),...ex.filter(a=>!(e.examples||[]).some(b=>b.lessonId===a.lessonId&&b.p===a.p&&b.text===a.text))].slice(0,10)}else{if(book.entries.length>=1500)return {ok:false,message:'词语本已满，请先导出备份并整理。'};const d=dictionary()[word];e={word,meaning:d?.meaning||'',en:d?.en||'',note:'',source:d?'本课语境释义':'释义待补充',examples:examples(word),lessons:[lesson.id],status:'new',createdAt:now,updatedAt:now};book.entries.unshift(e)}const d=dictionary()[word];if(d&&e.meaning&&e.meaning!==d.meaning){e.senses=e.senses||[];if(!e.senses.some(v=>v.lessonId===lesson.id&&v.meaning===d.meaning))e.senses.push({lessonId:lesson.id,meaning:d.meaning,en:d.en});}e.sources=sources(e);const source={lessonId:lesson.id,title:lesson.title,grade:lesson.grade,unit:lesson.unit};if(!e.sources.some(s=>s.lessonId===source.lessonId))e.sources.push(source);e.updatedAt=now;const saved=persist();return {ok:true,word,message:!saved?'已生成闪卡，但本机保存失败，请立即导出备份。':duplicate?'这个词已经在词语本里，已保留你的释义和复习记录。':e.meaning?'已加入词语本，自动生成含释义和原句的闪卡。':'已生成闪卡。这个词尚未收录，请在词语本里补充释义。'}}
 function list(){return book.entries.filter(e=>sources(e).some(filterSource)||(!sources(e).length&&!grade&&!unit&&!lessonFilter))}
 function open(){reload();refreshContext();if(!grade)grade=String(lesson.grade||'');lastFocus=document.activeElement;mode='list';notice='';render();const d=$('#wordDialog');if(d.showModal)d.showModal();else d.setAttribute('open','')}
 function close(){window.speechSynthesis?.cancel();$('#wordDialog').close?.();$('#wordDialog').removeAttribute('open');lastFocus?.focus?.()}
 const label=s=>({new:'新词',learning:'还不熟',known:'已记住'}[s]||'新词');
 function shell(inner){$('#wordDialogContent').innerHTML=`<h2>我的词语本</h2><p class="muted">同一浏览器中的收藏按年级、单元和课文汇总。</p><div class="notebook-nav"><button id="wordListTab" class="${mode==='list'?'active':''}">词语</button><button id="wordFlashTab" class="${mode==='flash'?'active':''}">闪卡</button><label>年级 <select id="wordGrade"><option value="">全部年级</option>${[1,2,3,4].map(g=>`<option value="${g}" ${grade===String(g)?'selected':''}>中${['','一','二','三','四'][g]}</option>`).join('')}<option value="?" ${grade==='?'?'selected':''}>未分类</option></select></label><label>单元 <select id="wordUnit"><option value="">全部单元</option>${[...new Set(catalogue.filter(c=>!grade||String(c.grade)===grade).map(c=>c.unit))].sort((a,b)=>a-b).map(u=>`<option value="${u}" ${unit===String(u)?'selected':''}>单元${u}</option>`).join('')}</select></label><label>课文 <select id="wordLesson"><option value="">全部课文</option>${catalogue.filter(c=>(!grade||String(c.grade)===grade)&&(!unit||String(c.unit)===unit)).map(c=>`<option value="${esc(c.id)}" ${lessonFilter===c.id?'selected':''}>${esc(c.title)}</option>`).join('')}</select></label><button id="thisLesson">本课</button><button id="exportWords">导出</button><label class="file-button">导入<input id="importWords" type="file" accept=".json,application/json"></label></div><p id="bookNotice" class="notice" role="status" ${notice?'':'hidden'}>${esc(notice)}</p>${inner}`;$('#wordListTab').onclick=()=>{mode='list';render()};$('#wordFlashTab').onclick=()=>{mode='flash';startDeck();render()};$('#wordGrade').onchange=e=>{grade=e.target.value;unit='';lessonFilter='';startDeck();render()};$('#wordUnit').onchange=e=>{unit=e.target.value;lessonFilter='';startDeck();render()};$('#wordLesson').onchange=e=>{lessonFilter=e.target.value;startDeck();render()};$('#thisLesson').onclick=()=>{refreshContext();grade=String(lesson.grade||'');unit=String(lesson.unit||'');lessonFilter=lesson.id;startDeck();render()};$('#exportWords').onclick=exportBook;$('#importWords').onchange=async e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>2*1024*1024){notice='文件过大，请选择词语本导出的JSON备份。';render();return}try{notice=importBook(JSON.parse(await f.text()))}catch{notice='备份格式不正确，原有词语没有被替换。'}render()}}
 function render(){if(mode==='flash'){renderFlash();return}shell(`<div class="word-add-row"><input id="bookNewWord" maxlength="20" aria-label="新增词语" placeholder="输入词语"><button id="bookAdd" class="primary">加入</button></div><p class="muted">${list().length} 个词语 · 点“编辑”补充释义、英文或自己的笔记。</p><div class="notebook-list">${list().length?list().map(e=>`<article class="notebook-word"><div><h3 class="kaiti">${esc(e.word)}</h3><span class="status-tag">${e.meaning?label(e.status):'释义待补充'}</span></div><p>${esc(e.meaning||'卡片已建立，释义尚待补充。')}</p>${e.en?`<details><summary>英文提示</summary><small lang="en">${esc(e.en)}</small></details>`:''}${(e.senses||[]).filter(v=>filterSource(sourceFor(v.lessonId,e))).map(v=>`<p>本课语境义: ${esc(v.meaning)}<br><small>${esc(v.en)}</small></p>`).join('')}<p class="word-sources">${sources(e).filter(filterSource).map(v=>esc(sourceLabel(v))).join('<br>')}</p>${(e.examples||[]).filter(x=>filterSource(sourceFor(x.lessonId,e))).slice(0,1).map(x=>`<blockquote class="kaiti">${esc(x.text)}<small>${esc(x.lessonTitle)}${x.p?' · 第'+x.p+'段':''}</small></blockquote>`).join('')}<div class="action-row"><button data-edit-word="${esc(e.word)}">编辑</button><button data-hear-word="${esc(e.word)}">朗读</button></div></article>`).join(''):'<p>读课文时输入或收藏不明白的词语，它们会出现在这里。</p>'}</div>`);const collect=()=>{const r=add($('#bookNewWord').value);notice=r.message;render()};$('#bookAdd').onclick=collect;$('#bookNewWord').onkeydown=e=>{if(e.key==='Enter')collect()};document.querySelectorAll('[data-edit-word]').forEach(b=>b.onclick=()=>edit(b.dataset.editWord));wireSpeech()}
 function edit(word){let e=book.entries.find(x=>x.word===word);if(!e)return;mode='edit';shell(`<h3 class="kaiti">${esc(word)}</h3><label class="answer-label" for="editMeaning">中文释义</label><textarea id="editMeaning" rows="3" maxlength="600">${esc(e.meaning)}</textarea><label class="answer-label" for="editEnglish">英文提示（可选）</label><input class="written-input" id="editEnglish" maxlength="400" value="${esc(e.en)}"><label class="answer-label" for="editNote">笔记／例句</label><textarea id="editNote" rows="3" maxlength="1000">${esc(e.note)}</textarea><p class="muted">来源：${esc(e.source)}。不确定时请老师确认。</p><div class="action-row"><button id="saveWordEdit" class="primary">保存</button><button id="cancelWordEdit">返回</button><button id="deleteWord">删除</button></div>`);$('#saveWordEdit').onclick=()=>{reload();e=book.entries.find(x=>x.word===word);if(!e){notice='这个词已在另一页面删除。';mode='list';render();return}e.meaning=$('#editMeaning').value.trim();e.en=$('#editEnglish').value.trim();e.note=$('#editNote').value.trim();e.source=e.meaning?'我的补充':'释义待补充';e.updatedAt=new Date().toISOString();if(!e.meaning&&e.status==='known')e.status='learning';notice=persist()?'卡片已更新。':'保存失败，请导出备份。';mode='list';render()};$('#cancelWordEdit').onclick=()=>{mode='list';render()};$('#deleteWord').onclick=()=>{if(window.confirm('从词语本删除“'+word+'”？')){reload();book.entries=book.entries.filter(x=>x.word!==word);persist();mode='list';notice='已删除这个词。';render()}}}
 function startDeck(){deck=list().filter(e=>includeKnown||e.status!=='known').map(e=>e.word);for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]]}index=0;flipped=false}
 function renderFlash(){const e=book.entries.find(x=>x.word===deck[index]);shell(`<label class="notebook-filter"><input id="includeKnown" type="checkbox" ${includeKnown?'checked':''}>包括已记住的词</label>${e?`<p class="muted">${index+1} / ${deck.length} · 先回想，再翻卡</p><article class="flashcard" aria-live="polite"><p class="flash-word kaiti">${esc(e.word)}</p>${flipped?`<div class="flash-back"><p>${esc(e.meaning||'释义待补充，请先编辑卡片。')}</p>${e.en?`<details><summary>英文提示</summary><small lang="en">${esc(e.en)}</small></details>`:''}${(e.senses||[]).filter(v=>filterSource(sourceFor(v.lessonId,e))).map(v=>`<p>本课语境义: ${esc(v.meaning)}<br><small>${esc(v.en)}</small></p>`).join('')}${(e.examples||[]).filter(x=>filterSource(sourceFor(x.lessonId,e))).slice(0,2).map(x=>`<blockquote class="kaiti">${esc(x.text)}<small>${esc(x.lessonTitle)}${x.p?' · 第'+x.p+'段':''}</small></blockquote>`).join('')}${e.note?`<p class="muted">我的笔记：${esc(e.note)}</p>`:''}</div>`:'<p>这个词在这里是什么意思？</p>'}<button data-hear-word="${esc(e.word)}">朗读</button><button id="flipCard" class="primary">${flipped?'返回词面':'翻卡看释义'}</button></article>${flipped?`<div class="action-row"><button data-mastery="learning">还不熟</button>${e.meaning?'<button data-mastery="known">已记住</button>':'<button id="fixFlashWord">补充释义</button>'}</div>`:''}<div class="action-row"><button id="previousCard" ${index===0?'disabled':''}>上一张</button><button id="nextCard">${index===deck.length-1?'完成':'下一张'}</button></div>`:`<div class="flashcard"><h3>${deck.length?'本轮复习完成':'暂时没有待复习的词'}</h3><p>可以回到词语本添加词语，或重新练习还不熟的词。</p><button id="restartCards">再练一次</button></div>`}`);$('#includeKnown').onchange=e=>{includeKnown=e.target.checked;startDeck();renderFlash()};$('#flipCard')?.addEventListener('click',()=>{flipped=!flipped;renderFlash()});$('#previousCard')?.addEventListener('click',()=>{index=Math.max(0,index-1);flipped=false;renderFlash()});$('#nextCard')?.addEventListener('click',()=>{index++;flipped=false;renderFlash()});$('#restartCards')?.addEventListener('click',()=>{startDeck();renderFlash()});$('#fixFlashWord')?.addEventListener('click',()=>edit(e.word));document.querySelectorAll('[data-mastery]').forEach(b=>b.onclick=()=>{reload();const current=book.entries.find(x=>x.word===e.word);if(!current){startDeck();renderFlash();return}current.status=b.dataset.mastery;current.lastReviewed=new Date().toISOString();current.updatedAt=current.lastReviewed;notice=persist()?'':'复习记录保存失败，请导出备份。';index++;flipped=false;renderFlash()});wireSpeech()}
 function hear(word){if(!window.speechSynthesis||!window.SpeechSynthesisUtterance){$('#bookNotice').hidden=false;$('#bookNotice').textContent='设备暂不支持朗读，请阅读文字。';return}window.speechSynthesis.cancel();const u=new window.SpeechSynthesisUtterance(word);u.lang='zh-CN';u.rate=.8;u.onerror=()=>{$('#bookNotice').hidden=false;$('#bookNotice').textContent='朗读未能播放，请阅读文字。'};window.speechSynthesis.speak(u)}
 function wireSpeech(){document.querySelectorAll('[data-hear-word]').forEach(b=>b.onclick=()=>hear(b.dataset.hearWord))}
 function exportBook(){reload();const u=URL.createObjectURL(new Blob([JSON.stringify(book,null,2)],{type:'application/json;charset=utf-8'}));const a=document.createElement('a');a.href=u;a.download='华文通_我的词语本.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}
 function importBook(data){if(data?.schema!==SCHEMA||!Array.isArray(data.entries)||data.entries.length>1500)throw Error('schema');reload();let added=0,merged=0,skipped=0;for(const raw of data.entries){const w=normal(raw?.word);if(!valid(w)||!raw||typeof raw!=='object'){skipped++;continue}const clip=(x,n)=>typeof x==='string'?x.slice(0,n):'';const item={sources:Array.isArray(raw.sources)?raw.sources.filter(x=>x&&typeof x.lessonId==='string').slice(0,60).map(x=>({lessonId:clip(x.lessonId,80),title:clip(x.title,150),grade:Number.isInteger(x.grade)&&x.grade>=1&&x.grade<=6?x.grade:null,unit:Number.isInteger(x.unit)&&x.unit>=1&&x.unit<=9?x.unit:null})):[],word:w,meaning:clip(raw.meaning,600),en:clip(raw.en,400),note:clip(raw.note,1000),source:'导入的个人备份',lessons:Array.isArray(raw.lessons)?raw.lessons.filter(x=>typeof x==='string').slice(0,60):[lesson.id],examples:Array.isArray(raw.examples)?raw.examples.filter(x=>x&&typeof x.text==='string').slice(0,10).map(x=>({text:clip(x.text,1500),lessonId:clip(x.lessonId,80),lessonTitle:clip(x.lessonTitle,150),p:Number.isInteger(x.p)&&x.p>=1&&x.p<=999?x.p:null})):[],senses:Array.isArray(raw.senses)?raw.senses.filter(x=>x&&typeof x.lessonId==='string'&&typeof x.meaning==='string').slice(0,60).map(x=>({lessonId:clip(x.lessonId,80),meaning:clip(x.meaning,600),en:clip(x.en,400)})):[],status:['new','learning','known'].includes(raw.status)?raw.status:'new',createdAt:clip(raw.createdAt,40),updatedAt:new Date().toISOString()};if(!item.meaning)item.status='new';const e=book.entries.find(x=>x.word===w);if(e){if(!e.meaning)e.meaning=item.meaning;if(!e.en)e.en=item.en;if(!e.note)e.note=item.note;e.lessons=[...new Set([...(e.lessons||[]),...item.lessons])];e.examples=[...(e.examples||[]),...item.examples.filter(x=>!(e.examples||[]).some(y=>x.text===y.text))].slice(0,10);e.sources=sources({...e,sources:[...(e.sources||[]),...item.sources],lessons:e.lessons});e.senses=[...(e.senses||[]),...item.senses.filter(x=>!(e.senses||[]).some(y=>x.lessonId===y.lessonId&&x.meaning===y.meaning))].slice(0,60);merged++}else if(book.entries.length<1500){book.entries.push(item);added++}else skipped++}const saved=persist();return `新增${added}个，合并${merged}个${skipped?'，跳过'+skipped+'个无效或超额条目':''}。同词保留本机已有释义。${saved?'':'本机保存失败，请导出备份。'}`}
 $('#wordDialogClose').onclick=close;window.WordBook={add,open,importBook,list,sources,context:()=>lesson};
})();
</script><script>/* Reusable textbook lesson engine. Content and stable question IDs live in content.js. */
(()=>{'use strict';
const L=window.LESSON,$=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KEY='huawentong-lesson-'+L.id+'-v1', cn=['一','二','三','四','五','六','七','八','九','十','十一','十二','十三','十四','十五','十六','十七','十八','十九'];
const empty=()=>({schema:'huawentong-lesson-v1',lessonId:L.id,contentVersion:L.version,sequenceVersion:L.sequenceVersion,sources:{},position:{view:'read',p:1,task:0},identity:{name:'',class:'',number:''},answers:{}});
let state=empty(),selected=null,persistFailed=false;try{const v=JSON.parse(localStorage.getItem(KEY));if(v?.lessonId===L.id&&v?.schema===state.schema)state={...state,...v,sequenceVersion:v.sequenceVersion||1}}catch{}
state.answers=state.answers||{};state.identity=state.identity||{name:'',class:'',number:''};
if(state.sequenceVersion!==L.sequenceVersion){if(Object.keys(state.answers).length){state.legacyVersions=state.legacyVersions||[];state.legacyVersions.push({version:state.contentVersion,answers:JSON.parse(JSON.stringify(state.answers))});const oldId=L.legacyOrder?.[state.position.task];const target=L.routeAliases?.[oldId]||oldId;state.position.task=Math.max(0,L.tasks.findIndex(t=>t.id===target));}state.sequenceVersion=L.sequenceVersion;state.contentVersion=L.version;}
state.sources=state.sources||{};
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state));persistFailed=false}catch{persistFailed=true}const n=$('#saveState');if(n)n.textContent=persistFailed?'保存失败，请导出记录':'已保存';};
const a=id=>state.answers[id]||(state.answers[id]={fields:{},choices:{},evidence:{},attempts:[],hintCount:0,revision:'',points:[],unlocked:false});
const allFields=t=>[...(t.fields||[]),...(t.answerTable?.fields||[])];
function fieldInput(f,x,label=f.label,limit=5000){return f.type==='select'?`<select id="field-${esc(f.id)}" data-field="${esc(f.id)}" aria-label="${esc(label)}"><option value="">请选择</option>${(f.options||[]).map(v=>`<option value="${esc(v)}" ${x.fields[f.id]===v?'selected':''}>${esc(v)}</option>`).join('')}</select>`:`<textarea id="field-${esc(f.id)}" data-field="${esc(f.id)}" rows="3" maxlength="${limit}" aria-label="${esc(label)}" placeholder="${esc(f.placeholder||'')}">${esc(x.fields[f.id]||'')}</textarea>`}
const task=()=>L.tasks[Math.max(0,Math.min(L.tasks.length-1,state.position.task))];
function kw(s,words=[]){let result=esc(s);[...words].sort((a,b)=>b.length-a.length).forEach(w=>result=result.split(esc(w)).join('<span class="key">'+esc(w)+'</span>'));return result}
function panel(n){const r=L.panelRects[n-1],sheet=L.panelSheets?.[n-1]||Math.ceil(n/10),src=window.LESSON_ASSETS?.['comic'+sheet]||'assets/comic'+sheet+'.png';return `<div class="panel" style="aspect-ratio:${r[2]}/${r[3]}"><img src="${src}" alt="原有漫画第${n}格" style="width:${1024/r[2]*100}%;left:${-r[0]/r[2]*100}%;top:${-r[1]/r[3]*100}%" loading="lazy"></div>`}
const pName=p=>'第'+(cn[p-1]||p)+(L.unitNoun||'段');
const sentences=p=>L.paragraphs[p-1].match(/[^。！？]+[。！？][”’]?|[^。！？]+$/g)||[L.paragraphs[p-1]];
function marked(s){const aliases=window.WORD_ALIASES||{},words=[...Object.keys(window.LESSON_WORDS),...Object.keys(aliases)].filter(w=>s.includes(w)).sort((a,b)=>b.length-a.length);if(!words.length)return esc(s);const re=new RegExp('('+words.join('|')+')','g');return s.split(re).map(v=>window.LESSON_WORDS[aliases[v]||v]?`<span class="word" role="button" tabindex="0" data-word="${esc(aliases[v]||v)}">${esc(v)}</span>`:esc(v)).join('')}
function figure(p){const f=L.figures?.[p];if(!f)return '';let body='';
const sourceImage=()=>{const r=f.rect,src=window.LESSON_ASSETS?.[f.src]||f.src;return `<div class="figure-crop" style="aspect-ratio:${r[2]}/${r[3]}"><img src="${esc(src)}" alt="${esc(f.alt||f.title)}" style="width:${f.imageWidth/r[2]*100}%;left:${-r[0]/r[2]*100}%;top:${-r[1]/r[3]*100}%" loading="lazy"></div>`};
if(f.kind==='sourceImage'||f.kind==='diagram'){body=sourceImage();if(f.rows)body+='<div class="diagram-text">'+f.rows.map(r=>'<p><strong>'+esc(r[0])+'</strong>：'+esc(r[1])+'</p>').join('')+'</div>';return '<figure class="data-figure"><figcaption>'+esc(f.title)+'</figcaption>'+body+'<p class="data-note">'+esc(f.note)+'</p></figure>';}
if(f.kind==='pie'){const colors=['#337951','#7f8d72','#efd967','#b0c64f','#cc635f'];let a=-Math.PI/2;body='<svg viewBox="0 0 200 200" role="img" aria-label="'+esc(f.title)+'">';f.rows.forEach((r,i)=>{const next=a+Number(r[1])/100*Math.PI*2;body+=`<path d="M100 100 L${100+88*Math.cos(a)} ${100+88*Math.sin(a)} A88 88 0 ${next-a>Math.PI?1:0} 1 ${100+88*Math.cos(next)} ${100+88*Math.sin(next)} Z" fill="${colors[i]}" stroke="white" stroke-width="1.5"/>`;a=next});body+='</svg><table><thead><tr><th>类别</th><th>比例</th></tr></thead><tbody>'+f.rows.map((r,i)=>'<tr><td><span class="chart-key" style="background:'+colors[i]+'"></span>'+esc(r[0])+'</td><td>'+esc(r[1])+'%</td></tr>').join('')+'</tbody></table>';return '<figure class="data-figure"><figcaption>'+esc(f.title)+'</figcaption>'+body+'<p class="data-note">'+esc(f.note)+'</p></figure>';}
if(f.kind==='table'){body='<table><thead><tr>'+f.headers.map(x=>'<th>'+esc(x)+'</th>').join('')+'</tr></thead><tbody>'+f.rows.map(r=>'<tr>'+r.map(x=>'<td>'+esc(x)+'</td>').join('')+'</tr>').join('')+'</tbody></table>'}else{const max=f.kind==='share'?100:f.kind==='bars'?30:180;body=f.rows.map((r,i)=>'<div class="bar-row"><span>'+esc(r[0])+'</span><span class="bar-track" aria-hidden="true"><span class="bar-fill '+(f.kind==='trend'&&i===f.rows.length-1?'target-bar':'')+'" style="width:'+(Number(r[1])/max*100)+'%"></span></span><strong>'+esc(r[1])+(f.unit==='%'?'%':'')+'</strong></div>').join('');if(f.unit!=='%')body+='<p>单位：'+esc(f.unit)+'／人／日</p>'}return '<figure class="data-figure"><figcaption>'+esc(f.title)+'</figcaption>'+body+'<p class="data-note">'+esc(f.note)+'</p></figure>'}
function paragraph(p,selectable){return `<section class="source-paragraph" id="p${p}"><h3>${pName(p)}${L.paragraphLabels?.[p-1]?" · "+esc(L.paragraphLabels[p-1]):""}</h3><div class="source-text">${sentences(p).map((s,i)=>selectable?`<span class="sentence" tabindex="0" role="button" data-p="${p}" data-i="${i}" draggable="true">${esc(s)}</span>`:marked(s)).join('')}</div>${figure(p)}</section>`}
function range(t){if(t.range.length===2)return Array.from({length:t.range[1]-t.range[0]+1},(_,i)=>t.range[0]+i);return t.range}
function route(){let h=location.hash.slice(1);if(h.startsWith('task-'))h='task-'+(L.routeAliases?.[h.slice(5)]||h.slice(5));if(h==='read')state.position={...state.position,view:'read'};if(/^paragraph-\d+$/.test(h)){state.position.view='read';state.position.p=Math.max(1,Math.min(L.paragraphs.length,+h.split('-')[1]))}if(/^lesson[123]$/.test(h)){state.position.view='task';state.position.task=L.tasks.findIndex(t=>t.lesson===+h.slice(-1))}const ti=L.tasks.findIndex(t=>'task-'+t.id===h);if(ti>=0){state.position.view='task';state.position.task=ti}if(h==='review')state.position.view='review';render();save();if(h==='words')window.WordBook.open()}
function go(hash){window.speechSynthesis?.cancel();selected=null;if(location.hash.slice(1)===hash)route();else location.hash=hash;window.scrollTo?.({top:0,behavior:'instant'})}
function render(){const view=state.position.view;$('#readTask').hidden=view==='review';$('#review').hidden=view!=='review';document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===(view==='task'?'lesson'+task().lesson:view)));if(view==='review'){review();return}if(view==='read')read();else activity()}
function read(){const p=state.position.p;$('#source').innerHTML=`<div class="toolbar"><button id="prevPara" ${p===1?'disabled':''}>上一${L.unitNoun||'段'}</button><select id="paragraphSelect" aria-label="选择${L.unitNoun||'段落'}">${L.paragraphs.map((_,i)=>`<option value="${i+1}" ${p===i+1?'selected':''}>${pName(i+1)}</option>`).join('')}</select><button id="nextPara">${p===L.paragraphs.length?(L.unitNoun?'本课问题':'段落练习'):('下一'+(L.unitNoun||'段'))}</button></div>${paragraph(p,false)}<div class="toolbar"><button id="readAloud">朗读</button><button id="stopAudio">停止</button></div><p id="audioState" class="muted" role="status"></p>${L.paragraphTasks?.[p-1]?`<p><button id="paragraphTask">本${L.unitNoun||'段'}问题</button></p>`:""}<details class="paragraph-idea"><summary>${L.unitNoun?'本'+L.unitNoun+'要点':'段落要点'}</summary><p class="kai">${esc(L.paragraphIdeas[p-1])}</p></details>`;
$('#activity').innerHTML=`<h2 class="para-name">${pName(p)}</h2><div class="panel-list">${L.panels[p-1].map(panel).join('')}</div><div class="word-add-row"><input id="newWord" maxlength="20" placeholder="输入词语" aria-label="输入不明白的词语"><button id="addWord">加入词语本</button></div><div class="actions"><button id="openWords">词语本</button></div><p id="wordNotice" role="status"></p>`;
$('#paragraphTask')?.addEventListener('click',()=>go('task-'+L.paragraphTasks[p-1]));$('#paragraphSelect').onchange=e=>go('paragraph-'+e.target.value);$('#prevPara').onclick=()=>go('paragraph-'+(p-1));$('#nextPara').onclick=()=>go(p===L.paragraphs.length?'lesson1':'paragraph-'+(p+1));$('#readAloud').onclick=()=>speak(L.paragraphs[p-1],$('#audioState'));$('#stopAudio').onclick=()=>{window.speechSynthesis?.cancel();$('#audioState').textContent='已停止'};const add=()=>{$('#wordNotice').textContent=window.WordBook.add($('#newWord').value).message};$('#addWord').onclick=add;$('#newWord').onkeydown=e=>{if(e.key==='Enter')add()};$('#openWords').onclick=()=>window.WordBook.open()}
function concept(t){if(t.conceptNotes?.length)return `<section class="concept">${t.conceptNotes.map(([name,explanation])=>`<p><b>${esc(name)}</b>：${esc(explanation)}</p>`).join('')}</section>`;switch(t.concept){case'idioms':return `<section class="concept"><p><b>惯用语</b>（idiom）：有固定比喻义的习惯用语。</p><dl class="idiom-list">${L.idioms.map(([w,m])=>`<dt>${esc(w)}</dt><dd>${esc(m)}</dd>`).join('')}</dl></section>`;case'description':return `<section class="concept"><p><b>语言描写</b>（dialogue）：说出口的话。<br><b>心理描写</b>（psychological description）：心里的想法。</p></section>`;case'effect':return `<section class="concept"><p><b>表达作用</b>（effect）：写出了什么？突出到什么程度？</p></section>`;case'character':return `<section class="concept"><p><b>特点＋依据＋解释</b></p><p>比较同一情境，说明具体行为反映什么特点。</p></section>`;case'open':return `<section class="concept"><p><b>立场</b>：我怎么看？<br><b>理由</b>：为什么？<br><b>例子</b>：什么事能说明？<br><b>回扣</b>（link back）：例子怎样支持看法？</p></section>`;default:return''}}
function activity(){const t=task(),x=a(t.id),ps=state.sources[t.id]?[state.sources[t.id]]:(t.focus||range(t));$('#source').innerHTML=`<div class="toolbar"><label for="taskSelect">${L.unitNoun?'图文问题':'段落问题'}</label><select id="taskSelect">${L.tasks.map((t,i)=>`<option value="${t.id}" ${i===state.position.task?'selected':''}>${esc(t.title)}</option>`).join('')}</select></div><p class="guide">${(L.unitNoun||L.simpleTaskGuide)&&!t.evidence?.length?'先看左边图文，再回答右边问题。':'点原句，再点“加入原句”。可连续加入多句，也可直接粘贴、修改。'}</p>${range(t).length>ps.length?`<label class="reference-nav">回看原文 <select id="sourceSelect">${range(t).map(p=>`<option value="${p}" ${ps.includes(p)?'selected':''}>${pName(p)}</option>`).join('')}</select></label>`:''}${ps.map(p=>paragraph(p,true)).join('')}`;
let form=(t.evidence||[]).map((e,i)=>`<div class="evidence-row"><label class="evidence-label" for="evidence-${i}">${esc(e.label)}</label><textarea class="evidence-input" id="evidence-${i}" data-evidence="${i}" rows="4" maxlength="12000" placeholder="可加入多句原文，也可复制、粘贴。">${esc(x.evidence[i]?.text||'')}</textarea><div class="actions"><button data-slot="${i}">加入原句</button><button data-remove="${i}">清空</button></div></div>`).join('');
form+=(t.checks||[]).map(c=>`<fieldset><legend>${esc(c.question)}</legend>${c.options.map((op,i)=>`<label class="option ${String(x.choices[c.id])===String(i)?'chosen':''}"><input type="radio" name="${c.id}" value="${i}" ${String(x.choices[c.id])===String(i)?'checked':''}><span>${'ABCD'[i]}. ${esc(op)}</span></label>`).join('')}</fieldset>`).join('');
if(t.blanks){if(!x.wordOrder){x.wordOrder=t.bank?[...t.bank]:L.idioms.map(x=>x[0]);for(let i=x.wordOrder.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x.wordOrder[i],x.wordOrder[j]]=[x.wordOrder[j],x.wordOrder[i]]}save()}form+=t.blanks.map((b,i)=>`<div class="blank-row">${i+1}. ${esc(b.before)} <select data-blank="${b.id}" aria-label="第${i+1}空"><option value="">请选择</option>${x.wordOrder.map(w=>`<option ${x.choices[b.id]===w?'selected':''}>${esc(w)}</option>`).join('')}</select> ${esc(b.after)}</div>`).join('')}
if(t.summaryRow)form+=`<table><tr><th>动物</th><th>概括主要特点</th></tr><tr><td>${esc(t.summaryRow)}</td><td><textarea id="summaryAnswer" aria-label="概括主要特点" maxlength="2000" rows="3" placeholder="先口头概括；需要记录时可填写。">${esc(x.summary||'')}</textarea></td></tr></table>`;
if(t.answerTable){const tb=t.answerTable;form+=`<p class="guide">${esc(tb.note||'')}</p><table class="answer-table"><thead><tr>${tb.headers.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody><tr><th scope="row">${esc(tb.name)}</th>${tb.fields.map(f=>`<td data-label="${esc(f.label)}">${fieldInput(f,x,tb.name+'：'+f.label,3000)}</td>`).join('')}</tr></tbody></table>`;}
form+=(t.fields||[]).map(f=>`<label class="answer-label" for="field-${esc(f.id)}">${esc(f.label)}</label>${fieldInput(f,x)}`).join('');
$('#activity').innerHTML=`<div class="eyebrow">${['','第一课','第二课','第三课'][t.lesson]} · ${t.scope==='full'?'全文综合':(t.order<=16?(t.focus||[]).map(pName).join('、'):'全文综合')}${t.required?' · 必做':''}</div><h2>${esc(t.title)}</h2>${t.questions.map(q=>`<p class="question">${kw(q,t.keywords)}</p>`).join('')}<p class="guide">${esc(t.guide)}</p>${concept(t)}${t.examples?.length?'<details><summary>课本例句</summary><table><tr><th>例句</th><th>用语</th></tr>'+t.examples.map(r=>'<tr><td>'+esc(r[0])+'</td><td>'+esc(r[1])+'</td></tr>').join('')+'</table></details>':''}${t.resources?.length?`<div class="actions">${t.resources.map(r=>`<a class="btn" href="${esc(r.url)}" target="_blank" rel="noopener">${esc(r.label)}</a>`).join('')}</div>`:''}${form}<div class="actions"><button id="submit" class="primary">${t.mode==='oral'?'展开讲评':t.mode==='objective'?'检查':'提交比较'}</button><button id="hint">提示</button></div><div id="feedback" role="status"></div><div id="solution">${x.unlocked?solution(t,x):''}</div><p class="question-source">${esc(t.source)}</p><div class="task-footer"><button id="prevTask" ${state.position.task===0?'disabled':''}>上一题</button><button id="nextTask">${state.position.task===L.tasks.length-1?'检查':'下一题'}</button></div>`;
$('#summaryAnswer')?.addEventListener('input',e=>{x.summary=e.target.value;save()});$('#sourceSelect')?.addEventListener('change',e=>{state.sources[t.id]=+e.target.value;save();activity()});document.querySelectorAll('[data-evidence]').forEach(e=>e.oninput=()=>{x.evidence[e.dataset.evidence]={text:e.value,items:parseEvidence(e.value)};save()});$('#taskSelect').onchange=e=>go('task-'+e.target.value);document.querySelectorAll('input[type=radio]').forEach(el=>el.onchange=()=>{x.choices[el.name]=+el.value;save();el.closest('fieldset').querySelectorAll('.option').forEach(n=>n.classList.toggle('chosen',n.querySelector('input').checked))});document.querySelectorAll('[data-blank]').forEach(el=>el.onchange=()=>{x.choices[el.dataset.blank]=el.value;save()});document.querySelectorAll('[data-field]').forEach(el=>el.oninput=()=>{x.fields[el.dataset.field]=el.value;save()});
document.querySelectorAll('[data-slot]').forEach(b=>{b.onclick=()=>put(+b.dataset.slot);b.ondragover=e=>e.preventDefault();b.ondrop=e=>{e.preventDefault();try{const v=JSON.parse(e.dataTransfer.getData('text/plain'));if(valid(v))selected=v}catch{}put(+b.dataset.slot)}});document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{delete x.evidence[b.dataset.remove];save();activity()});$('#submit').onclick=check;$('#hint').onclick=()=>{x.hintCount++;save();feedback(t.hints[Math.min(x.hintCount-1,t.hints.length-1)])};$('#prevTask').onclick=()=>go('task-'+L.tasks[state.position.task-1].id);$('#nextTask').onclick=()=>{if(t.required&&!x.first){feedback(t.requiredMessage||(t.answerTable?'请先完成本题的必填表格。':'请先完成理由、例子和回扣。'));return}go(state.position.task===L.tasks.length-1?'review':'task-'+L.tasks[state.position.task+1].id)};wireSolution(t,x);applyLock(x)}
function parseEvidence(raw){const clean=String(raw||'').replace(/^第[一二三四五六七八九十\d]+(?:段|部分)\s*/gm,'').trim();if(!clean)return [];const chunks=clean.match(/[^。！？]+[。！？][”’]?|[^。！？]+$/g)||[];const out=[];for(const chunk of chunks){const text=chunk.trim();if(!text)continue;const p=L.paragraphs.findIndex(v=>v.includes(text));if(p<0)return [];out.push({p:p+1,text});}return out}
function valid(v){return typeof v?.text==='string'&&parseEvidence(v.text).length>0}
function put(i){if(!valid(selected)){feedback('先点选左边的原句。');return}const x=a(task().id),previous=x.evidence[i]?.text||'',items=parseEvidence(previous);if(!items.some(e=>e.p===selected.p&&e.text===selected.text)){x.evidence[i]={text:previous+(previous?'\n':'')+selected.text};x.evidence[i].items=parseEvidence(x.evidence[i].text);}save();selected=null;activity()}
const match=(v,r)=>valid(v)&&parseEvidence(v.text).some(e=>r.p.includes(e.p)&&r.terms.some(s=>e.text.includes(s)))&&(!r.requiredTerms||r.requiredTerms.every(s=>v.text.includes(s)));
function objective(t,x){return (t.checks||[]).every(c=>x.choices[c.id]===c.correct)&&(t.blanks||[]).every(b=>x.choices[b.id]===b.answer)&&(t.evidence||[]).every((r,i)=>match(x.evidence[i],r))&&allFields(t).filter(f=>f.type==='select'&&f.correct!==undefined).every(f=>x.fields[f.id]===f.correct)}
function feedback(s,ok=false){$('#feedback').innerHTML=`<p class="${ok?'success':'notice'}">${esc(s)}</p>`}
function applyLock(x){const b=$('#submit');if(!b)return;const delay=Math.max(0,(x.lockUntil||0)-Date.now());b.disabled=!!delay;if(delay){const id=task().id;setTimeout(()=>{if(state.position.view==='task'&&task().id===id)applyLock(x)},delay+20)}}
function check(){const t=task(),x=a(t.id);if(t.mode==='oral'){x.unlocked=true;save();activity();return}if(Date.now()<(x.lockUntil||0))return;if((t.checks||[]).some(c=>x.choices[c.id]===undefined)||(t.blanks||[]).some(b=>!x.choices[b.id])){feedback('请完成点选。');return}if((t.evidence||[]).some((e,i)=>!valid(x.evidence[i]))){feedback('请在每个证据框加入原句。');return}if(allFields(t).some(f=>!f.optional&&!x.fields[f.id]?.trim())){feedback('请补齐回答。');return}
const snapshot={summary:x.summary||'',fields:JSON.parse(JSON.stringify(x.fields)),choices:{...x.choices},evidence:JSON.parse(JSON.stringify(x.evidence)),timestamp:new Date().toISOString(),assisted:x.hintCount>0};const correct=t.mode==='objective'?objective(t,x):(t.checks||[]).every(c=>x.choices[c.id]===c.correct);if(!x.first){x.first=snapshot;x.firstCorrect=t.mode==='objective'?correct:null}x.attempts.push({...snapshot,correct:t.mode==='objective'?correct:null});
if(correct){x.unlocked=true;save();feedback(t.mode==='objective'?(L.objectiveSuccess||'回答正确，请核对依据和解释。'):'已保存，请对照意思与依据后订正。主观题由教师核对。',true);$('#solution').innerHTML=solution(t,x);wireSolution(t,x);return}
x.lockUntil=Date.now()+5000;save();feedback(t.hints[Math.min(x.attempts.length-1,t.hints.length-1)]);applyLock(x);if(x.attempts.length>=2){const b=document.createElement('button');b.textContent='看讲解';b.disabled=true;$('#feedback').append(b);const id=t.id;setTimeout(()=>{if(task().id===id)b.disabled=false},5000);b.onclick=()=>{if(Date.now()<x.lockUntil)return;x.unlocked=true;x.guided=true;save();activity()}}}
function solution(t,x){return `<section class="solution"><h3>对照</h3><p>${esc(t.explain)}</p>${t.checks?.length?`<details><summary>选项解析</summary>${t.checks.map(c=>`<h4 class="kai">${esc(c.question)}</h4>${c.options.map((o,i)=>`<p>${'ABCD'[i]}. ${esc(c.why[i])}${i===c.correct?' ✓':''}</p>`).join('')}`).join('')}</details>`:''}<h3>参考答案</h3><p class="model">${esc(t.answer)}</p>${(t.alternatives||[]).map(s=>`<p>${esc(s)}</p>`).join('')}<details><summary>易错点</summary><p>${esc(t.reject)}</p></details><div class="selfcheck"><h3>自检</h3>${t.points.map((p,i)=>`<label><input type="checkbox" data-point="${i}" ${x.points.includes(i)?'checked':''}>${esc(p)}</label>`).join('')}<small>自检不等于评分。</small></div>${(allFields(t).length||t.summaryRow)?`<h3>首次回答</h3><p class="model">${[x.first?.summary||'',...Object.values(x.first?.fields||{})].filter(Boolean).map(esc).join('<br>')||'本题采用口头概括。'}</p><label class="answer-label" for="revision">订正</label><textarea id="revision" maxlength="10000" rows="4">${esc(x.revision)}</textarea>`:''}${t.oral?`<div class="oral-block"><h3>口头追问</h3>${t.oral.map(([q,ans])=>`<p class="question">${esc(q)}</p><details><summary>展开参考</summary><p>${esc(ans)}</p></details>`).join('')}</div>`:''}</section>`}
function wireSolution(t,x){$('#revision')?.addEventListener('input',e=>{x.revision=e.target.value;save()});document.querySelectorAll('[data-point]').forEach(b=>b.onchange=()=>{const s=new Set(x.points);b.checked?s.add(+b.dataset.point):s.delete(+b.dataset.point);x.points=[...s];save()})}
function review(){const objectiveTasks=L.tasks.filter(t=>t.mode==='objective'),attempted=objectiveTasks.filter(t=>a(t.id).first),correct=attempted.filter(t=>a(t.id).firstCorrect).length,required=L.tasks.filter(t=>t.required&&!a(t.id).first);$('#review').innerHTML=`<h2>学习记录</h2><p class="muted">记录保存在当前设备，可导出备份。</p><div class="identity">${[['name','姓名'],['class','班级'],['number','学号／组别']].map(([k,label])=>`<label>${label}<input data-identity="${k}" maxlength="60" value="${esc(state.identity[k]||'')}"></label>`).join('')}</div>${state.legacyVersions?.length?'<p class="muted">旧版回答已保留在完整备份中。拆开的题目重新作答，不把旧答案套入新题。</p>':''}${required.map(t=>`<p class="notice">必做题未完成 <button data-go="${t.id}">${esc(t.title)}</button></p>`).join('')}<p>${esc(L.accuracyLabel||'客观题首次正确率')}: ${attempted.length?Math.round(correct/attempted.length*100)+'%':'—'} (${correct}/${attempted.length})</p><p class="muted">主观题由教师核对，不计入自动正确率。</p>${L.tasks.map((t,i)=>`<div class="record-row"><span>${esc(t.title)}</span><small>${a(t.id).unlocked?'已对照':a(t.id).first?'待订正':'未提交'}</small><button data-go="${t.id}">返回</button></div>`).join('')}<div class="actions"><button id="downloadJSON">完整备份</button><button id="downloadCSV">逐题记录</button><button id="downloadText">文字记录</button><button id="resetLesson">重置本课</button></div>${L.tasks.filter(t=>allFields(t).length).map(t=>{const x=a(t.id);return `<section class="record"><h3>${esc(t.title)}</h3><h4>首次回答</h4><p class="kai">${esc(Object.values(x.first?.fields||{}).join('\n')||'未提交')}</p><h4>订正</h4><p class="kai">${esc(x.revision||'—')}</p></section>`}).join('')}`;document.querySelectorAll('[data-identity]').forEach(e=>e.oninput=()=>{state.identity[e.dataset.identity]=e.value;save()});document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>go('task-'+b.dataset.go));$('#downloadJSON').onclick=()=>download(L.title+'_学习记录.json',JSON.stringify(state,null,2),'application/json');$('#downloadText').onclick=exportText;$('#downloadCSV').onclick=exportCSV;$('#resetLesson').onclick=()=>{dialog(`<h2>重置本课？</h2><p>请先导出备份。重置本课会保留词语本。</p><div class="actions"><button id="backupReset">先备份</button><button id="confirmReset">确认重置</button></div>`);$('#backupReset').onclick=()=>download(L.title+'_学习记录.json',JSON.stringify(state,null,2),'application/json');$('#confirmReset').onclick=()=>{state=empty();save();closeDialog();go('read')}}}
function download(name,body,type='text/plain;charset=utf-8'){const u=URL.createObjectURL(new Blob([body],{type})),link=document.createElement('a');link.href=u;link.download=name;link.click();setTimeout(()=>URL.revokeObjectURL(u),1000)}
function exportText(){const lines=[...(state.legacyVersions?.length?['旧版记录：'+JSON.stringify(state.legacyVersions)]:[]),L.label+'《'+L.title+'》',JSON.stringify(state.identity),'主观题未自动评分。'];L.tasks.forEach(t=>{const x=a(t.id);lines.push('\n'+t.title,...t.questions,'首次：'+JSON.stringify(x.first||{}),'订正：'+x.revision,'尝试记录：'+JSON.stringify(x.attempts),'自检：'+JSON.stringify(x.points))});download(L.title+'_学习记录.txt',lines.join('\n'))}
function exportCSV(){const rows=[['lesson','name','class','number','task_id','question','first_answer','first_choices','first_evidence','first_correct','timestamp','attempts','revision','selfcheck','reviewed','first_summary','current_summary']];L.tasks.forEach(t=>{const x=a(t.id);rows.push([L.id,state.identity.name,state.identity.class,state.identity.number,t.id,t.questions.join('；'),JSON.stringify(x.first?.fields||{}),JSON.stringify(x.first?.choices||{}),JSON.stringify(x.first?.evidence||{}),x.firstCorrect===null||x.firstCorrect===undefined?'not_auto_graded':String(x.firstCorrect),x.first?.timestamp||'',JSON.stringify(x.attempts),x.revision,JSON.stringify(x.points),String(x.unlocked),x.first?.summary||'',x.summary||''])});const cell=v=>'"'+String(v??'').replace(/^[=+@-]/,"'$&").replace(/"/g,'""')+'"';download(L.title+'_逐题记录.csv','\uFEFF'+rows.map(r=>r.map(cell).join(',')).join('\r\n'),'text/csv;charset=utf-8')}
function dialog(html){$('#dialogContent').innerHTML=html;$('#dialog').showModal?.();if(!$('#dialog').open)$('#dialog').setAttribute('open','')}
function closeDialog(){window.speechSynthesis?.cancel();$('#dialog').close?.();$('#dialog').removeAttribute('open')}
function speak(s,n){if(!window.speechSynthesis||!window.SpeechSynthesisUtterance){if(n)n.textContent='设备不支持朗读';return}window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(s);u.lang='zh-CN';u.rate=.85;if(n)n.textContent='设备朗读';u.onerror=()=>{if(n)n.textContent='朗读失败'};window.speechSynthesis.speak(u)}
document.addEventListener('click',e=>{const w=e.target.closest('[data-word]');if(w){const term=w.dataset.word,d=window.LESSON_WORDS[term];dialog(`<h2 class="kai">${esc(term)}</h2><p>${esc(d.meaning)}</p>${d.en?`<details><summary>英文提示</summary><p>${esc(d.en)}</p></details>`:``}<button id="collectWord">加入词语本</button><p id="collectNotice"></p>`);$('#collectWord').onclick=()=>{$('#collectNotice').textContent=window.WordBook.add(term).message};return}const s=e.target.closest('.sentence');if(s){selected={p:+s.dataset.p,text:sentences(+s.dataset.p)[+s.dataset.i]};document.querySelectorAll('.sentence.selected').forEach(n=>n.classList.remove('selected'));s.classList.add('selected')}});
document.addEventListener('keydown',e=>{if(['Enter',' '].includes(e.key)&&e.target.matches('.sentence,[data-word]')){e.preventDefault();e.target.click()}});document.addEventListener('dragstart',e=>{const s=e.target.closest('.sentence');if(s)e.dataTransfer.setData('text/plain',JSON.stringify({p:+s.dataset.p,text:sentences(+s.dataset.p)[+s.dataset.i]}))});
$('#dialogClose').onclick=closeDialog;document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>go(b.dataset.view));$('#wordList').onclick=()=>window.WordBook.open();window.addEventListener('hashchange',route);window.LessonEngine={state:()=>state,valid,objective,range,panel};route();
})();
</script><script>/* Uses the shared lesson record; no separate student identity store. */
(()=>{const host=document.querySelector('#topIdentity'),state=()=>window.LessonEngine.state(),key='huawentong-lesson-'+window.LESSON.id+'-v1';for(const [name,label]of [['name','姓名'],['class','班级'],['number','学号／组别']]){const l=document.createElement('label');l.textContent=label;const i=document.createElement('input');i.maxLength=60;i.value=state().identity[name]||'';i.setAttribute('aria-label',label);i.oninput=()=>{state().identity[name]=i.value;try{localStorage.setItem(key,JSON.stringify(state()));document.querySelector('#saveState').textContent='已保存'}catch{document.querySelector('#saveState').textContent='保存失败，请导出记录'}};l.append(i);host.append(l)}window.addEventListener('hashchange',()=>{host.querySelectorAll('input').forEach((i,n)=>i.value=state().identity[['name','class','number'][n]]||'')})})();
</script><script>(()=>{'use strict';const activity=document.querySelector('#activity'),source=document.querySelector('#source'),L=window.LESSON;function go(h){window.speechSynthesis?.cancel();location.hash=h;window.scrollTo?.({top:0,behavior:'instant'})}function enhance(){const state=window.LessonEngine.state();if(state.position.view==='read'){const p=state.position.p,t=L.paragraphTasks[p-1];if(t){const next=document.querySelector('#nextPara');next.textContent='完成本段问题';next.onclick=()=>go('task-'+t)}if(!activity.querySelector('.word-support')){const box=document.createElement('section');box.className='word-support';box.innerHTML='<b>本段词语</b><p>点击词语查看释义；需要复习时再收藏。</p>';for(const[w,v]of Object.entries(window.LESSON_WORDS)){if(v.paragraph!==p||w==='奢侈')continue;const b=document.createElement('button');b.className='word';b.dataset.word=w;b.textContent=w;box.append(b)}activity.querySelector('.word-add-row').before(box)}}if(state.position.view==='task'){const t=L.tasks[state.position.task];const next=document.querySelector('#nextTask');const map={goods:5,logistics:7,culture:8};if(map[t.id]){next.textContent='继续读第'+map[t.id]+'段';next.onclick=()=>go('paragraph-'+map[t.id])}if(!activity.querySelector('.sequence-nav')){const nav=document.createElement('div');nav.className='sequence-nav';nav.innerHTML='<a class="btn" href="#paragraph-'+t.focus[0]+'">回到本段图文</a>';activity.querySelector('.task-footer').before(nav)}if(t.id==='goods'&&!activity.querySelector('.oral-probe')){const d=document.createElement('details');d.className='oral-probe';d.innerHTML='<summary>完成后口头想一想</summary><p>除了货物，还有什么随着贸易传播？请回看第一、第四段。</p>';activity.querySelector('.question-source').before(d)}}}const obs=new MutationObserver(()=>{obs.disconnect();enhance();watch()});function watch(){obs.observe(activity,{childList:true});obs.observe(source,{childList:true})}enhance();watch()})();</script><script>document.getElementById("offlineComics").addEventListener("toggle",function(){const host=document.getElementById("offlineComicPages");if(this.open&&!host.children.length)for(let i=1;i<=4;i++){const img=document.createElement("img");img.src=window.LESSON_ASSETS["comic"+i];img.alt="原漫画第"+i+"页";host.append(img)}});</script></body></html>