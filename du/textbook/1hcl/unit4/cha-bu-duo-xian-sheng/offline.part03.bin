.word-support-visible .word{color:#bd202b;-webkit-text-fill-color:#bd202b;font-weight:700;text-decoration-line:underline;text-decoration-style:solid;text-decoration-color:#bd202b;text-decoration-thickness:1px;text-underline-offset:5px}
.word-support-visible .word:focus-visible{outline:2px solid #bd202b;outline-offset:3px}
