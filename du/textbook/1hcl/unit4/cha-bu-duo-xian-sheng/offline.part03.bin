);font-display:swap}
:root{--ink:#243d37;--green:#245e51;--red:#b03e37;--muted:#62736d;--line:#d5e0d8;--paper:#fffcf6;font-family:LessonSong,serif;color:var(--ink);background:#f4f7f3;font-size:17px}*{box-sizing:border-box}body{margin:0}a{color:var(--green);text-underline-offset:4px}button,input,select,textarea{font:inherit;color:inherit}button,select,.btn,summary{min-height:46px;touch-action:manipulation}button,.btn,select{border:1px solid #a8bbb0;border-radius:8px;background:white;padding:10px 14px;cursor:pointer;text-decoration:none}button:hover,.btn:hover{background:#edf4ed}button:disabled{opacity:.5;cursor:default}button.active,.primary{background:var(--green);color:white;border-color:var(--green)}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible,select:focus-visible{outline:3px solid #d69a32;outline-offset:3px}.kai,.kaiti,textarea,.question,.model,.sentence,.option{font-family:LessonKai,KaiTi,serif}.key{color:var(--red);font-weight:700}h1,h2,h3,p{margin-top:0}h1{font:52px LessonKai,serif;margin-bottom:12px}h2{font-size:28px}h3{font-size:21px;margin:24px 0 12px}p{line-height:1.8}.muted,small{color:var(--muted)}small{font-size:15px;line-height:1.5}.site-header{background:white;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px;padding:10px 24px}.site-header img{width:230px;max-width:45vw;height:auto;display:block}.site-header span{font-size:15px}main{max-width:1240px;margin:auto;padding:24px 24px 60px}.nav,.actions,.toolbar,.word-add-row,.notebook-nav,.action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0}.nav{margin:0;padding:12px 24px;background:#f4f7f3;border-bottom:1px solid var(--line)}.nav button{font-size:16px}.crumb{margin-bottom:22px;color:var(--muted);font-size:15px}.workspace{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:28px;align-items:start}.paper{background:var(--paper);padding:26px;border:1px solid var(--line);border-radius:12px}.source-text{font:25px/2 LessonKai,serif;white-space:normal;overflow-wrap:anywhere}.source-paragraph{margin-bottom:26px}.source-paragraph h3{font:19px LessonSong,serif;color:var(--green);margin-top:0}.sentence{border-radius:4px;cursor:pointer}.sentence.selected{background:#ffecb3;box-shadow:0 0 0 2px #c58d25}.word{color:var(--green);text-decoration:underline dotted;text-underline-offset:6px;cursor:pointer}.para-name{font:30px LessonKai,serif}.panel{position:relative;overflow:hidden;background:#f7e8d7;width:100%;margin-bottom:16px}.panel img{position:absolute;max-width:none;height:auto;display:block}.panel-list{max-width:600px}.paragraph-idea{margin-top:20px}.paragraph-idea summary{color:var(--green)}.question{font-size:25px;line-height:1.7}.guide{font-size:16px;line-height:1.65;color:var(--green)}.eyebrow{font-size:15px;color:var(--red);margin-bottom:12px}.evidence{width:100%;text-align:left;min-height:66px;border:2px dashed #a8b9ab;margin:8px 0;font:20px/1.6 LessonKai,serif;background:white}.evidence.filled{border-style:solid;background:#eef4ec}.evidence-label{font-size:16px}.evidence-row{margin-bottom:15px}.remove-evidence{font-size:14px;padding:3px 10px;min-height:36px}.option{display:flex;align-items:flex-start;gap:10px;background:white;border:1px solid var(--line);border-radius:8px;padding:14px;margin:10px 0;font-size:22px;line-height:1.5;cursor:pointer}.option input{margin-top:8px;min-width:20px;min-height:20px}.option.chosen{border-color:var(--green);background:#edf5ee}fieldset{border:0;padding:0;margin:20px 0}legend{font:22px/1.6 LessonKai,serif}input[type=text],input:not([type]),textarea{background:white;border:1px solid #adbbb1;border-radius:7px;padding:12px;max-width:100%}textarea{display:block;width:100%;font-size:22px;line-height:1.7;resize:vertical;min-height:100px}.answer-label{display:block;margin:20px 0 8px;font-size:17px}.word-add-row input{flex:1;min-width:140px;width:0}.notice{background:#fff0cf;border-left:4px solid #bf871d;pad